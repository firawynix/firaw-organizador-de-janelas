<Window x:Class="FirawynixWindowManager.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw · Regra de janela" Width="700" Height="800" Background="#0C1117"
        MinWidth="620" MinHeight="600" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UiTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="28,24,28,18">
      <TextBlock x:Name="HeadingText" Text="Nova regra" FontSize="25" FontWeight="SemiBold"
                 Foreground="{StaticResource Text}" />
      <TextBlock Text="Defina quais janelas seguirão esta posição."
                 FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,0,28,16">
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Nome da regra" Foreground="{StaticResource Text}" FontWeight="SemiBold"
                       FontSize="13" Margin="0,0,0,9" />
            <TextBox x:Name="RuleNameBox" Style="{StaticResource Field}" MaxLength="80" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="Quais janelas?" Foreground="{StaticResource Text}"
                       FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Uma regra específica substitui a regra geral quando combina com a janela."
                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,13" />
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="AllRadio" GroupName="Match" Content="Todas" Style="{StaticResource ChoiceRadio}"
                           Checked="Options_Changed" />
              <RadioButton x:Name="TitleRadio" GroupName="Match" Content="Título contém"
                           Style="{StaticResource ChoiceRadio}" Checked="Options_Changed" />
              <RadioButton x:Name="TypeRadio" GroupName="Match" Content="Mesmo tipo"
                           Style="{StaticResource ChoiceRadio}" Checked="Options_Changed" />
            </StackPanel>
            <StackPanel x:Name="TitleSection" Margin="0,15,0,0">
              <TextBlock Text="Trecho estável do título" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,0,0,7" />
              <TextBox x:Name="TitleBox" Style="{StaticResource Field}" />
            </StackPanel>
            <TextBlock x:Name="SampleText" Foreground="{StaticResource Muted}" FontSize="11"
                       TextTrimming="CharacterEllipsis" Margin="0,13,0,0" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="12" Padding="18">
          <StackPanel>
            <TextBlock Text="Onde abrir?" Foreground="{StaticResource Text}"
                       FontWeight="SemiBold" FontSize="15" Margin="0,0,0,13" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <RadioButton x:Name="AreaRadio" GroupName="Placement" Content="Área escolhida"
                           Style="{StaticResource ChoiceRadio}" Checked="Options_Changed" />
              <RadioButton x:Name="FullRadio" GroupName="Placement" Content="Tela cheia"
                           Style="{StaticResource ChoiceRadio}" Checked="Options_Changed" />
            </StackPanel>
            <Border Background="{StaticResource Raised}" CornerRadius="9" Padding="14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="MONITOR" Foreground="{StaticResource Muted}"
                             FontSize="10" FontWeight="SemiBold" />
                  <TextBlock x:Name="MonitorText" Foreground="{StaticResource Text}"
                             FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="Escolher monitor" Style="{StaticResource SecondaryButton}"
                        Background="{StaticResource Line}"
                        Click="ChooseMonitor_Click" Margin="14,0,0,0" />
              </Grid>
            </Border>
            <Grid x:Name="AreaSection" Margin="0,13,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Content="Desenhar área na tela" Style="{StaticResource PrimaryButton}"
                      Click="DrawArea_Click" />
              <TextBlock x:Name="AreaText" Grid.Column="1" Foreground="{StaticResource Muted}"
                         FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"
                         TextTrimming="CharacterEllipsis" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                Click="Cancel_Click" IsCancel="True" Margin="0,0,8,0" />
        <Button Content="Salvar regra" Style="{StaticResource PrimaryButton}"
                Click="Save_Click" IsDefault="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
