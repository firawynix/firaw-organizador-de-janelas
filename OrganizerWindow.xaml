<Window x:Class="FirawynixWindowManager.OrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw · Organizador de Janelas"
        Width="1120" Height="730" MinWidth="900" MinHeight="590"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UiTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="82" />
      <RowDefinition Height="*" />
      <RowDefinition Height="45" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Cyan}">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Rectangle Width="44" Height="44" VerticalAlignment="Center" Fill="#0C1117">
          <Rectangle.OpacityMask>
            <ImageBrush ImageSource="pack://application:,,,/assets/celtic-knot-transparent.png" Stretch="Uniform" />
          </Rectangle.OpacityMask>
        </Rectangle>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock Text="Firaw" FontSize="18" FontWeight="SemiBold" Foreground="#071014" />
          <TextBlock Text="Organizador de Janelas" FontSize="13" Foreground="#18333C" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#D8071014" CornerRadius="12" Padding="12,6" Margin="0,0,12,0">
            <TextBlock x:Name="ActivityText" Text="●  Ativo" Foreground="White" FontWeight="SemiBold" />
          </Border>
          <Button x:Name="PauseButton" Content="Pausar" Style="{StaticResource SecondaryButton}"
                  Background="#151D26" Click="Pause_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="292" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
              BorderThickness="0,0,1,0">
        <Grid Margin="18,20,18,16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="PROGRAMAS" Foreground="{StaticResource Muted}" FontWeight="SemiBold"
                     FontSize="12" Margin="6,0,0,13" />
          <Button Grid.Row="1" Content="+  Capturar janela aberta" Style="{StaticResource PrimaryButton}"
                  Click="CaptureProgram_Click" Margin="0,0,0,15" />
          <ListBox x:Name="ProgramsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource CardItem}" SelectionChanged="Programs_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                             Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}"
                             FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <Button Content="Escolher arquivo .exe" Style="{StaticResource SecondaryButton}"
                    Click="BrowseProgram_Click" Margin="0,0,0,10" />
            <Button Content="Monitores e nomes" Style="{StaticResource SecondaryButton}"
                    Click="Monitors_Click" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" Margin="30,24,30,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock x:Name="ProfileNameText" Text="Escolha um programa" FontSize="26"
                       FontWeight="SemiBold" Foreground="{StaticResource Text}" />
            <TextBlock x:Name="ProfilePathText" Text="Capture uma janela ou selecione um arquivo para começar."
                       FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button x:Name="RemoveProgramButton" Content="Remover" Style="{StaticResource DangerButton}"
                    Click="RemoveProgram_Click" Margin="0,0,8,0" />
            <Button x:Name="NewRuleButton" Content="+  Nova regra" Style="{StaticResource PrimaryButton}"
                    Click="AddRule_Click" />
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="Regras específicas têm prioridade sobre a regra geral."
                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,22,0,16" />

        <Grid Grid.Row="2">
          <ListBox x:Name="RulesList" Background="Transparent" BorderThickness="0"
                   ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="83">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}"
                                 FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding State}" Foreground="{StaticResource Cyan}"
                                 FontSize="11" Margin="12,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Match}" Foreground="{StaticResource Muted}"
                               FontSize="12" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Destination}" Foreground="{StaticResource Cyan}"
                               FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                              Margin="15,0,0,0">
                    <Button Content="Editar" Style="{StaticResource QuietButton}"
                            Tag="{Binding}" Click="EditRule_Click" Margin="0,0,7,0" />
                    <Button Content="{Binding ToggleLabel}" Style="{StaticResource QuietButton}"
                            Tag="{Binding}" Click="ToggleRule_Click" Margin="0,0,7,0" />
                    <Button Content="Excluir" Style="{StaticResource DangerButton}"
                            Tag="{Binding}" Click="RemoveRule_Click" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border x:Name="EmptyRules" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
              <TextBlock Text="▤" FontSize="44" Foreground="{StaticResource Cyan}"
                         HorizontalAlignment="Center" />
              <TextBlock Text="Nenhuma regra ainda" FontSize="19" FontWeight="SemiBold"
                         Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,8,0,0" />
              <TextBlock Text="Crie uma regra para escolher onde as janelas deste programa vão abrir."
                         FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Center"
                         TextWrapping="Wrap" Margin="0,8,0,16" />
              <Button Content="Criar primeira regra" Style="{StaticResource PrimaryButton}"
                      HorizontalAlignment="Center" Click="AddRule_Click" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
            BorderThickness="0,1,0,0">
      <Grid Margin="22,0">
        <TextBlock x:Name="StatusText" Text="Pronto para organizar janelas" Foreground="{StaticResource Muted}"
                   FontSize="11" VerticalAlignment="Center" />
        <TextBlock Text="Fechar mantém o organizador na área de notificação" Foreground="{StaticResource Muted}"
                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
