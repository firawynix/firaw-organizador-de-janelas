<Window x:Class="FirawynixWindowManager.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firaw · Escolher janela" Width="680" Height="570"
        MinWidth="560" MinHeight="450" WindowStartupLocation="CenterOwner" Background="#0C1117"
        FontFamily="Segoe UI Variable Text, Segoe UI">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="UiTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{StaticResource Bg}" Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Escolha a janela" Foreground="{StaticResource Text}"
                 FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="Selecione um dos programas abertos abaixo."
                 Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,18" />
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" Style="{StaticResource Field}"
               TextChanged="Search_Changed" />
      <TextBlock Text="Buscar janela ou programa" Foreground="{StaticResource Muted}"
                 Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>
    <ListBox x:Name="WindowsList" Grid.Row="2" Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource CardItem}" MouseDoubleClick="Windows_DoubleClick"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid MinHeight="49">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}"
                         FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding App}" Foreground="{StaticResource Muted}"
                         FontSize="11" Margin="0,5,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="{StaticResource Cyan}"
                       FontSize="12" VerticalAlignment="Center" Margin="18,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button Content="Atualizar" Style="{StaticResource SecondaryButton}"
              Click="Refresh_Click" />
      <Button Grid.Column="2" Content="Cancelar" Style="{StaticResource SecondaryButton}"
              Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
      <Button Grid.Column="3" Content="Usar janela" Style="{StaticResource PrimaryButton}"
              Click="Confirm_Click" IsDefault="True" />
    </Grid>
  </Grid>
</Window>
